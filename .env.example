# Bitget Trace — przykładowa konfiguracja alertów
# Skopiuj do .env i uzupełnij

# Interwał pollingu (sekundy)
POLL_INTERVAL=60

# Próg USD zmiany salda, poniżej którego nie alertujemy
MIN_USD_DELTA=1000

# Minimalne saldo USD adresu do watchlisty (domyślnie top holdery)
WATCH_MIN_USD=1000000

# Zawsze obserwuj te adresy (oddzielone przecinkami)
WATCH_EXTRA=t1WgMdtND8NF7NDUuYmq8MpMj1NTCXkMDVG,7EKUW3XG3W2LW37N4AALS54FFXIPPDRD5W47C7UD44S6Z2XNNFMXQA4UJ4

# Discord webhook (opcjonalnie)
DISCORD_WEBHOOK_URL=

# Telegram bot (opcjonalnie)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
